# Docker Compose environment template
#
# Quick start:
#   cp .env.example .env
#   mkdir -p ~/hermes-workspace
#   docker compose pull
#   docker compose up -d
#
# On macOS/Linux, set these to your current user:
#   id -u
#   id -g
UID=1000
GID=1000

# Base directory for all Hermes bind mounts.
# Compose will create hermes/, webui/, and workspace/ subdirectories under this path.
HERMES_WORKSPACE=./data

# Recommended if you expose WebUI beyond 127.0.0.1.
HERMES_WEBUI_PASSWORD=change-this-strong-password
