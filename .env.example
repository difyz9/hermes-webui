# Docker Compose environment template
#
# Quick start:
#   cp .env.example .env
#   mkdir -p ~/hermes-workspace
#   docker compose pull
#   docker compose up -d
#
# On macOS/Linux, set these to your current user:
#   id -u
#   id -g
UID=1000
GID=1000

# The only host directory exposed to Hermes.
# Default is a workspace folder inside this repository for one-click startup.
HERMES_WORKSPACE=./workspace

# Recommended if you expose WebUI beyond 127.0.0.1.
HERMES_WEBUI_PASSWORD=change-this-strong-password
